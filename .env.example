# Google Gemini API (required for Gemini TTS voiceover and built-in Gemini scripts)
# Get a free or paid key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Puck

# Optional: Gemini Google Search Grounding (requires billing-enabled Gemini API Paid Tier)
ENABLE_GEMINI_SEARCH_GROUNDING=false

# Optional: Script / Storyboard LLM endpoint selector (gemini | openai_compatible)
# You can also add and switch OpenAI-compatible endpoints directly in Studio Settings & Health.
LLM_PROVIDER=gemini
OPENAI_COMPAT_NAME=OpenAI-Compatible (.env)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Official Meta Graph API (required only when publishing to Instagram)
# See docs/meta-instagram-setup.md for step-by-step setup
META_GRAPH_API_VERSION=v27.0
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Optional GitHub token for higher release-check rate limits during topic discovery
GITHUB_TOKEN=

# Branding & local runtime
BRAND_HANDLE=@ai.dev.reels
WHISPER_CLI_PATH=
SERVER_PORT=4310
DATA_DIR=./data
